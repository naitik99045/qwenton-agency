rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "netiktalreja@gmail.com" ||
        request.auth.uid == "xFrBVnoWqWWpVEgQzuOqDDjiIAg1" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // Users Collection (Strict Privilege Escalation Prevention)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Prevent standard users from setting role="admin" or unauthorized planId during creation
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin()) &&
        (!('planId' in request.resource.data) || request.resource.data.planId == 'normal' || isAdmin());

      // Prevent standard users from mutating role, planId, status, or active count directly
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.status == resource.data.status
      );

      allow delete: if isAdmin();

      // User Integrations Subcollection (API keys & OAuth tokens)
      match /integrations/{provider} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Plans Collection (Public Read, Admin Write)
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Agents Collection
    match /agents/{agentId} {
      allow read: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Messages Collection
    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Approvals Collection
    match /approvals/{approvalId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Files & Document Chunks (Tenant Isolated)
    match /files/{fileId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /documentChunks/{chunkId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Routines Collection
    match /routines/{routineId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Telegram Connections
    match /telegramConnections/{connId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Orders Collection (Strict Server/Admin Write)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Audit Events Collection (Immutable Append-Only)
    match /auditEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
